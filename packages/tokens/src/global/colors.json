      "800": { "$value": "#99ffaa", "$type": "color" },
      "900": { "$value": "#ccffdd", "$type": "color", "$description": "Lightest matrix green" }
    },
    "black": {
      "pure": { "$value": "#000000", "$type": "color", "$description": "Pure black - main background" },
      "soft": { "$value": "#0d0d0d", "$type": "color", "$description": "Soft black for surfaces" },
      "surface": { "$value": "#1a1a1a", "$type": "color", "$description": "Elevated surface color" },
      "border": { "$value": "#2a2a2a", "$type": "color", "$description": "Subtle border color" }
    },
    "white": {
      "pure": { "$value": "#ffffff", "$type": "color" },
