{
  "name": "@sendell-trix/react",
  "version": "1.0.0",
  "description": "React wrapper components for sendell-trix design system",
  "keywords": [
    "react",
    "components",
    "design-system",
    "matrix",
    "web-components",
    "lit"
  ],
  "license": "MIT",
  "author": "Sendell Trix Team",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "clean": "rm -rf dist",
    "dev": "tsc --watch",
    "lint": "eslint src --ext .ts,.tsx",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@lit/react": "^1.0.0",
    "sendell-trix": "workspace:*"
  },
  "peerDependencies": {
    "react": "^17.0.0 || ^18.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.0",
    "react": "^18.2.0",
    "typescript": "^5.3.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
